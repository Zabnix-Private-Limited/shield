model Complaint {
  id               BigInt    @id @default(autoincrement())
  customerId       BigInt?   @map("customer_id")
  complaintType    String?   @map("complaint_type") @db.VarChar(100)
  description      String?   @db.Text
  status           String?   @db.VarChar(50)
  assignedToUserId BigInt?   @map("assigned_to_user_id")
  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz(6)
  resolvedByUserId BigInt?   @map("resolved_by_user_id")
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote   String?   @map("resolution_note") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        Customer?                 @relation(fields: [customerId], references: [id])
  assignedToUser  User?                     @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedByUser  User?                     @relation("ComplaintResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  lifecycleEvents ComplaintLifecycleEvent[]

  @@index([customerId, status], map: "idx_complaints_customer_status")
  @@index([assignedToUserId, status], map: "idx_complaints_assignee_status")
  @@map("complaints")
}

model ComplaintLifecycleEvent {
  id                 BigInt   @id @default(autoincrement())
  uuid               String   @unique @db.Uuid
  complaintId        BigInt   @map("complaint_id")
  eventType          String   @map("event_type") @db.VarChar(50)
  actorUserId        BigInt?  @map("actor_user_id")
  fromAssigneeUserId BigInt?  @map("from_assignee_user_id")
  toAssigneeUserId   BigInt?  @map("to_assignee_user_id")
  note               String?  @db.Text
  customerVisible    Boolean  @default(false) @map("customer_visible")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorUser User?     @relation("ComplaintLifecycleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt], map: "idx_complaint_lifecycle_events_complaint_created")
  @@index([customerVisible, createdAt], map: "idx_complaint_lifecycle_events_visible_created")
  @@map("complaint_lifecycle_events")
}

