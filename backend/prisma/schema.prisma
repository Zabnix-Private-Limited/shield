// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------
// Core Identity Tables
// ------------------------------
model Business {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @db.Uuid
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(255)
  businessType String?  @map("business_type") @db.VarChar(100)
  status       String?  @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments                      Department[]
  serviceProviders                 ServiceProvider[]
  shieldCards                      ShieldCard[]
  branchScopedUsers                User[]                            @relation("BranchScopedUsers")
  agentBranchAssignments           AgentBranchAssignment[]
  providerProfileBranchAssignments ProviderProfileBranchAssignment[]
  erpExistingCustomers             ErpExistingCustomer[]

  @@map("businesses")
}

model Department {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @db.Uuid
  businessId BigInt   @map("business_id")
  code       String?  @db.VarChar(50)
  name       String?  @db.VarChar(255)
  status     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users    User[]

  @@map("departments")
}

model Role {
  id           BigInt   @id @default(autoincrement())
  uuid         String?  @unique @db.Uuid
  code         String?  @unique @db.VarChar(50)
  name         String?  @db.VarChar(255)
  description  String?  @db.Text
  userType     String?  @map("user_type") @db.VarChar(30)
  defaultScope String?  @map("default_scope") @db.VarChar(30)
  isSystemRole Boolean? @default(false) @map("is_system_role")

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id          BigInt  @id @default(autoincrement())
  uuid        String? @unique @db.Uuid
  code        String? @unique @db.VarChar(100)
  name        String? @db.VarChar(255)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               BigInt    @id @default(autoincrement())
  uuid             String    @unique @db.Uuid
  employeeCode     String?   @map("employee_code") @db.VarChar(50)
  firstName        String?   @map("first_name") @db.VarChar(255)
  lastName         String?   @map("last_name") @db.VarChar(255)
  mobile           String?   @unique @db.VarChar(20)
  email            String?   @unique @db.VarChar(255)
  passwordHash     String?   @map("password_hash") @db.Text
  firebaseUid      String?   @unique @map("firebase_uid") @db.VarChar(128)
  authProvider     String?   @map("auth_provider") @db.VarChar(30)
  userType         String?   @map("user_type") @db.VarChar(30)
  accessScope      String?   @map("access_scope") @db.VarChar(30)
  branchBusinessId BigInt?   @map("branch_business_id")
  roleId           BigInt?   @map("role_id")
  departmentId     BigInt?   @map("department_id")
  status           String?   @db.VarChar(50)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  role           Role?       @relation(fields: [roleId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id])
  branchBusiness Business?   @relation("BranchScopedUsers", fields: [branchBusinessId], references: [id])

  createdCustomers                 Customer[]                 @relation("CustomerCreatedBy")
  approvedCustomers                Customer[]                 @relation("CustomerApprovedBy")
  customerStatusHistory            CustomerStatusHistory[]
  reviewedMembershipApplications   MembershipApplication[]
  walletTransactions               WalletTransaction[]
  cashWalletTransactions           CashWalletTransaction[]
  rewardPointTransactionsCreated   RewardPointTransaction[]   @relation("RewardPointTransactionCreatedBy")
  rewardPointTransactionsApproved  RewardPointTransaction[]   @relation("RewardPointTransactionApprovedBy")
  benefitLedgerTransactionsCreated BenefitLedgerTransaction[] @relation("BenefitLedgerTransactionCreatedBy")
  crmActivities                    CrmActivity[]
  crmTasks                         CrmTask[]
  auditLogs                        AuditLog[]
  authDevices                      AuthDevice[]
  authSessions                     AuthSession[]
  loginHistory                     LoginHistory[]
  documents                        Document[]
  agentPreference                  AgentPreference?
  agentBranchAssignments           AgentBranchAssignment[]
  providerProfile                  ProviderProfile?
  reviewedStoreChangeRequests      StoreChangeRequest[]       @relation("StoreChangeReviewer")
  assignedComplaints               Complaint[]                @relation("ComplaintAssignee")
  resolvedComplaints               Complaint[]                @relation("ComplaintResolver")
  complaintLifecycleEvents         ComplaintLifecycleEvent[]  @relation("ComplaintLifecycleActor")

  @@index([mobile], map: "idx_user_mobile")
  @@index([email], map: "idx_user_email")
  @@index([roleId], map: "idx_user_role")
  @@index([firebaseUid], map: "idx_user_firebase_uid")
  @@index([branchBusinessId], map: "idx_user_branch_business")
  @@map("users")
}

model AgentPreference {
  id                      BigInt    @id @default(autoincrement())
  uuid                    String    @unique @db.Uuid
  userId                  BigInt    @unique @map("user_id")
  themePreference         String?   @map("theme_preference") @db.VarChar(50)
  languagePreference      String?   @map("language_preference") @db.VarChar(20)
  timezone                String?   @db.VarChar(100)
  availability            Json?
  workingHours            Json?     @map("working_hours")
  workingArea             Json?     @map("working_area")
  emergencyContact        Json?     @map("emergency_contact")
  notificationPreferences Json?     @map("notification_preferences")
  dashboardLayout         Json?     @map("dashboard_layout")
  profilePreferences      Json?     @map("profile_preferences")
  devicePreferences       Json?     @map("device_preferences")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_preferences")
}

model AgentBranchAssignment {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @db.Uuid
  userId        BigInt    @map("user_id")
  businessId    BigInt    @map("business_id")
  status        String    @default("PENDING") @db.VarChar(50)
  isPrimary     Boolean   @default(false) @map("is_primary")
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  transferredAt DateTime? @map("transferred_at") @db.Timestamptz(6)
  inactiveAt    DateTime? @map("inactive_at") @db.Timestamptz(6)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "agent_branch_assignments_user_business_key")
  @@index([userId], map: "idx_agent_branch_assignment_user")
  @@index([businessId], map: "idx_agent_branch_assignment_business")
  @@index([status], map: "idx_agent_branch_assignment_status")
  @@map("agent_branch_assignments")
}

// ------------------------------
// Customer & Membership Tables
// ------------------------------
model Customer {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @db.Uuid
  customerCode  String?   @unique @map("customer_code") @db.VarChar(50)
  aadhaarNumber String?   @unique @map("aadhaar_number") @db.VarChar(20)
  firstName     String?   @map("first_name") @db.VarChar(255)
  lastName      String?   @map("last_name") @db.VarChar(255)
  dob           DateTime? @db.Date
  gender        String?   @db.VarChar(20)
  mobile        String    @unique @db.VarChar(20)
  email         String?   @db.VarChar(255)
  addressLine1  String?   @map("address_line1") @db.Text
  addressLine2  String?   @map("address_line2") @db.Text
  city          String?   @db.VarChar(100)
  district      String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  pincode       String?   @db.VarChar(20)
  status        String?   @db.VarChar(50)
  createdBy     BigInt?   @map("created_by")
  approvedBy    BigInt?   @map("approved_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  bloodGroup       String?   @map("blood_group") @db.VarChar(10)
  agentCode        String    @map("agent_code") @db.VarChar(50)
  referralCode     String?   @unique @map("referral_code") @db.VarChar(50)
  referredById     BigInt?   @map("referred_by_id")
  firebaseUid      String?   @unique @map("firebase_uid") @db.VarChar(128)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  onboardingSource String    @default("NEW_REGISTRATION") @map("onboarding_source") @db.VarChar(50)

  createdByUser     User?      @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  approvedByUser    User?      @relation("CustomerApprovedBy", fields: [approvedBy], references: [id])
  referredBy        Customer?  @relation("CustomerReferral", fields: [referredById], references: [id])
  referredCustomers Customer[] @relation("CustomerReferral")

  customerContacts               CustomerContact[]
  customerAddresses              CustomerAddress[]
  customerDependents             CustomerDependent[]
  customerPreferences            CustomerPreference?
  storeChangeRequests            StoreChangeRequest[]
  customerStatusHistory          CustomerStatusHistory[]
  membership                     Membership?
  membershipApplications         MembershipApplication[]
  shieldCard                     ShieldCard?
  wallet                         Wallet?
  walletRechargeIntents          WalletRechargeIntent[]
  creditAccount                  CreditAccount?
  purchases                      Purchase[]
  appointments                   Appointment[]
  consultations                  Consultation[]
  documents                      Document[]
  prescriptions                  Prescription[]
  prescriptionPharmacyRequests   PrescriptionPharmacyRequest[]
  labReports                     LabReport[]
  dentalRecords                  DentalRecord[]
  crmActivities                  CrmActivity[]
  crmTasks                       CrmTask[]
  erpExistingCustomers           ErpExistingCustomer[]        @relation("ErpMatchedCustomer")
  complaints                     Complaint[]
  notifications                  Notification[]
  devicePushTokens               DevicePushToken[]
  authDevices                    AuthDevice[]
  authSessions                   AuthSession[]
  loginHistory                   LoginHistory[]
  referralRewardEventsAsReferrer ReferralRewardEvent[]         @relation("ReferralRewardReferrer")
  referralRewardEventsAsReferred ReferralRewardEvent[]         @relation("ReferralRewardReferred")
  pricingRuleAudits              PricingRuleAudit[]

  @@index([mobile], map: "idx_customer_mobile")
  @@index([aadhaarNumber], map: "idx_customer_aadhaar")
  @@index([firebaseUid], map: "idx_customer_firebase_uid")
  @@map("customers")
}

model CustomerContact {
  id          BigInt    @id @default(autoincrement())
  customerId  BigInt    @map("customer_id")
  name        String?   @db.VarChar(255)
  relation    String?   @db.VarChar(100)
  mobile      String?   @db.VarChar(20)
  isPrimary   Boolean?  @default(false) @map("is_primary")
  contactType String    @default("ALTERNATIVE") @map("contact_type") @db.VarChar(30)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model CustomerAddress {
  id           BigInt    @id @default(autoincrement())
  uuid         String    @unique @db.Uuid
  customerId   BigInt    @map("customer_id")
  label        String    @default("HOME") @db.VarChar(50)
  addressLine1 String    @map("address_line1") @db.Text
  addressLine2 String?   @map("address_line2") @db.Text
  city         String?   @db.VarChar(100)
  district     String?   @db.VarChar(100)
  state        String?   @db.VarChar(100)
  pincode      String?   @db.VarChar(20)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt], map: "idx_customer_addresses_customer")
  @@map("customer_addresses")
}

model CustomerDependent {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @unique @db.Uuid
  customerId BigInt    @map("customer_id")
  firstName  String    @map("first_name") @db.VarChar(255)
  lastName   String?   @map("last_name") @db.VarChar(255)
  relation   String    @db.VarChar(100)
  dob        DateTime? @db.Date
  gender     String?   @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt], map: "idx_customer_dependents_customer")
  @@map("customer_dependents")
}

model CustomerPreference {
  id                      BigInt   @id @default(autoincrement())
  uuid                    String   @unique @db.Uuid
  customerId              BigInt   @unique @map("customer_id")
  notificationPreferences Json?    @map("notification_preferences")
  language                String?  @db.VarChar(20)
  theme                   String?  @db.VarChar(30)
  preferredProviderId     BigInt?  @map("preferred_provider_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model StoreChangeRequest {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique @db.Uuid
  customerId          BigInt    @map("customer_id")
  previousProviderId  BigInt?   @map("previous_provider_id")
  requestedProviderId BigInt    @map("requested_provider_id")
  reason              String    @db.Text
  status              String    @default("PENDING") @db.VarChar(50)
  reviewReason        String?   @map("review_reason") @db.Text
  reviewedBy          BigInt?   @map("reviewed_by")
  submittedAt         DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  previousProvider  ServiceProvider? @relation("StoreChangePreviousProvider", fields: [previousProviderId], references: [id], onDelete: SetNull)
  requestedProvider ServiceProvider  @relation("StoreChangeRequestedProvider", fields: [requestedProviderId], references: [id], onDelete: Restrict)
  reviewer          User?            @relation("StoreChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([customerId, status], map: "idx_store_change_requests_customer_status")
  @@index([status, submittedAt], map: "idx_store_change_requests_status_submitted")
  @@map("store_change_requests")
}

model CustomerStatusHistory {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique @db.Uuid
  customerId BigInt   @map("customer_id")
  oldStatus  String?  @map("old_status") @db.VarChar(50)
  newStatus  String?  @map("new_status") @db.VarChar(50)
  changedBy  BigInt?  @map("changed_by")
  remarks    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  changedByUser User?    @relation(fields: [changedBy], references: [id])

  @@index([customerId], map: "idx_customer_status_history_customer")
  @@index([createdAt], map: "idx_customer_status_history_date")
  @@map("customer_status_history")
}

model MembershipType {
  id                 BigInt   @id @default(autoincrement())
  uuid               String?  @unique @db.Uuid
  code               String?  @unique @db.VarChar(50)
  name               String?  @db.VarChar(255)
  joiningFee         Decimal? @map("joining_fee") @db.Decimal(12, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  creditEligible     Boolean? @map("credit_eligible")
  status             String?  @db.VarChar(50)

  memberships Membership[]

  @@map("membership_types")
}

model Membership {
  id               BigInt    @id @default(autoincrement())
  uuid             String?   @unique @db.Uuid
  customerId       BigInt?   @unique @map("customer_id")
  membershipTypeId BigInt?   @map("membership_type_id")
  membershipNumber String?   @unique @map("membership_number") @db.VarChar(100)
  joiningFee       Decimal?  @map("joining_fee") @db.Decimal(12, 2)
  activationDate   DateTime? @map("activation_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  status           String?   @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer?       @relation(fields: [customerId], references: [id])
  membershipType MembershipType? @relation(fields: [membershipTypeId], references: [id])

  @@map("memberships")
}

model MembershipApplication {
  id           BigInt    @id @default(autoincrement())
  uuid         String    @unique @db.Uuid
  customerId   BigInt    @map("customer_id")
  status       String    @default("PENDING") @db.VarChar(50)
  reference    String    @unique @db.VarChar(100)
  reviewReason String?   @map("review_reason") @db.Text
  reviewedBy   BigInt?   @map("reviewed_by")
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewer User?    @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([customerId, status], map: "idx_membership_applications_customer_status")
  @@index([submittedAt], map: "idx_membership_applications_submitted_at")
  @@map("membership_applications")
}

model ShieldCard {
  id               BigInt    @id @default(autoincrement())
  uuid             String?   @unique @db.Uuid
  customerId       BigInt?   @unique @map("customer_id")
  cardNumber       String?   @unique @map("card_number") @db.VarChar(100)
  qrCode           String?   @map("qr_code") @db.Text
  status           String?   @db.VarChar(50)
  issuedBusinessId BigInt?   @map("issued_business_id")
  issuedAt         DateTime? @map("issued_at") @db.Timestamptz(6)

  customer       Customer? @relation(fields: [customerId], references: [id])
  issuedBusiness Business? @relation(fields: [issuedBusinessId], references: [id])

  @@map("shield_cards")
}

// ------------------------------
// Wallet & Credit Tables
// ------------------------------
model Wallet {
  id         BigInt   @id @default(autoincrement())
  uuid       String?  @unique @db.Uuid
  customerId BigInt?  @unique @map("customer_id")
  status     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer                Customer?                  @relation(fields: [customerId], references: [id])
  walletTransactions      WalletTransaction[]
  cashTransactions        CashWalletTransaction[]
  rewardPointTransactions RewardPointTransaction[]
  benefitTransactions     BenefitLedgerTransaction[]
  pricingRuleAudits       PricingRuleAudit[]
  rechargeIntents         WalletRechargeIntent[]

  @@map("wallets")
}

model WalletRechargeIntent {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @db.Uuid
  customerId        BigInt    @map("customer_id")
  walletId          BigInt    @map("wallet_id")
  amount            Decimal   @db.Decimal(15, 2)
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(120)
  providerCode      String?   @map("provider_code") @db.VarChar(80)
  providerReference String?   @unique @map("provider_reference") @db.VarChar(160)
  status            String    @default("INITIATED") @db.VarChar(40)
  failureCode       String?   @map("failure_code") @db.VarChar(100)
  failureReason     String?   @map("failure_reason") @db.Text
  creditedAt        DateTime? @map("credited_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([customerId, status, createdAt], map: "idx_wallet_recharge_intents_customer_status")
  @@index([walletId, status], map: "idx_wallet_recharge_intents_wallet_status")
  @@map("wallet_recharge_intents")
}

model WalletTransaction {
  id                BigInt    @id @default(autoincrement())
  uuid              String?   @unique @db.Uuid
  walletId          BigInt?   @map("wallet_id")
  transactionType   String?   @map("transaction_type") @db.VarChar(50)
  subLedgerType     String?   @default("CASH") @map("sub_ledger_type") @db.VarChar(50)
  amount            Decimal?  @db.Decimal(15, 2)
  referenceType     String?   @map("reference_type") @db.VarChar(100)
  referenceId       BigInt?   @map("reference_id")
  remarks           String?   @db.Text
  isCustomerVisible Boolean?  @default(true) @map("is_customer_visible")
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  metadata          Json?     @map("metadata")
  createdBy         BigInt?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet        Wallet? @relation(fields: [walletId], references: [id])
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  @@index([walletId], map: "idx_wallet_transaction_wallet")
  @@index([transactionType], map: "idx_wallet_transaction_type")
  @@index([createdAt], map: "idx_wallet_transaction_date")
  @@map("wallet_transactions")
