// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------
// Core Identity Tables
// ------------------------------
model Business {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  code          String     @unique @db.VarChar(50)
  name          String     @db.VarChar(255)
  businessType  String?    @db.VarChar(100) @map("business_type")
  status        String?    @default("ACTIVE") @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  departments   Department[]
  serviceProviders ServiceProvider[]
  shieldCards   ShieldCard[]

  @@map("businesses")
}

model Department {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  businessId    BigInt     @map("business_id")
  code          String?    @db.VarChar(50)
  name          String?    @db.VarChar(255)
  status        String?    @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users         User[]

  @@map("departments")
}

model Role {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  code          String?    @unique @db.VarChar(50)
  name          String?    @db.VarChar(255)
  description   String?    @db.Text

  rolePermissions RolePermission[]
  users         User[]

  @@map("roles")
}

model Permission {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  code          String?    @unique @db.VarChar(100)
  name          String?    @db.VarChar(255)
  description   String?    @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        BigInt     @map("role_id")
  permissionId  BigInt     @map("permission_id")

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  employeeCode  String?    @db.VarChar(50) @map("employee_code")
  firstName     String?    @db.VarChar(255) @map("first_name")
  lastName      String?    @db.VarChar(255) @map("last_name")
  mobile        String?    @unique @db.VarChar(20)
  email         String?    @unique @db.VarChar(255)
  passwordHash  String?    @db.Text @map("password_hash")
  roleId        BigInt?    @map("role_id")
  departmentId  BigInt?    @map("department_id")
  status        String?    @db.VarChar(50)
  lastLoginAt   DateTime?  @db.Timestamptz(6) @map("last_login_at")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?  @db.Timestamptz(6) @map("deleted_at")

  role          Role?      @relation(fields: [roleId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])

  createdCustomers Customer[] @relation("CustomerCreatedBy")
  approvedCustomers Customer[] @relation("CustomerApprovedBy")
  customerStatusHistory CustomerStatusHistory[]
  walletTransactions WalletTransaction[]
  crmActivities CrmActivity[]
  crmTasks CrmTask[]
  auditLogs AuditLog[]
  documents Document[]

  @@index([mobile], map: "idx_user_mobile")
  @@index([email], map: "idx_user_email")
  @@index([roleId], map: "idx_user_role")
  @@map("users")
}

// ------------------------------
// Customer & Membership Tables
// ------------------------------
model Customer {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  customerCode  String?    @unique @db.VarChar(50) @map("customer_code")
  aadhaarNumber String?    @unique @db.VarChar(20) @map("aadhaar_number")
  firstName     String?    @db.VarChar(255) @map("first_name")
  lastName      String?    @db.VarChar(255) @map("last_name")
  dob           DateTime?  @db.Date
  gender        String?    @db.VarChar(20)
  mobile        String     @unique @db.VarChar(20)
  email         String?    @db.VarChar(255)
  addressLine1  String?    @db.Text @map("address_line1")
  addressLine2  String?    @db.Text @map("address_line2")
  city          String?    @db.VarChar(100)
  district      String?    @db.VarChar(100)
  state         String?    @db.VarChar(100)
  pincode       String?    @db.VarChar(20)
  status        String?    @db.VarChar(50)
  createdBy     BigInt?    @map("created_by")
  approvedBy    BigInt?    @map("approved_by")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?  @db.Timestamptz(6) @map("deleted_at")
  
  bloodGroup    String?    @db.VarChar(10) @map("blood_group")
  agentCode     String     @db.VarChar(50) @map("agent_code")
  referralCode  String?    @unique @db.VarChar(50) @map("referral_code")
  referredById  BigInt?    @map("referred_by_id")

  createdByUser User?      @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  approvedByUser User?     @relation("CustomerApprovedBy", fields: [approvedBy], references: [id])
  referredBy    Customer?  @relation("CustomerReferral", fields: [referredById], references: [id])
  referredCustomers Customer[] @relation("CustomerReferral")
  
  customerContacts CustomerContact[]
  customerStatusHistory CustomerStatusHistory[]
  membership    Membership?
  shieldCard    ShieldCard?
  wallet        Wallet?
  creditAccount CreditAccount?
  purchases     Purchase[]
  appointments  Appointment[]
  consultations Consultation[]
  documents     Document[]
  prescriptions Prescription[]
  labReports    LabReport[]
  dentalRecords DentalRecord[]
  crmActivities CrmActivity[]
  crmTasks      CrmTask[]
  complaints    Complaint[]
  notifications Notification[]
  devicePushTokens DevicePushToken[]

  @@index([mobile], map: "idx_customer_mobile")
  @@index([aadhaarNumber], map: "idx_customer_aadhaar")
  @@map("customers")
}

model CustomerContact {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt     @map("customer_id")
  name          String?    @db.VarChar(255)
  relation      String?    @db.VarChar(100)
  mobile        String?    @db.VarChar(20)
  isPrimary     Boolean?   @default(false) @map("is_primary")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model CustomerStatusHistory {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  customerId    BigInt     @map("customer_id")
  oldStatus     String?    @db.VarChar(50) @map("old_status")
  newStatus     String?    @db.VarChar(50) @map("new_status")
  changedBy     BigInt?    @map("changed_by")
  remarks       String?    @db.Text
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  changedByUser User?      @relation(fields: [changedBy], references: [id])

  @@index([customerId], map: "idx_customer_status_history_customer")
  @@index([createdAt], map: "idx_customer_status_history_date")
  @@map("customer_status_history")
}

model MembershipType {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  code          String?    @unique @db.VarChar(50)
  name          String?    @db.VarChar(255)
  joiningFee    Decimal?   @db.Decimal(12, 2) @map("joining_fee")
  discountPercentage Decimal? @db.Decimal(5, 2) @map("discount_percentage")
  creditEligible Boolean?  @map("credit_eligible")
  status        String?    @db.VarChar(50)

  memberships   Membership[]

  @@map("membership_types")
}

model Membership {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @unique @map("customer_id")
  membershipTypeId BigInt? @map("membership_type_id")
  membershipNumber String? @unique @db.VarChar(100) @map("membership_number")
  joiningFee    Decimal?   @db.Decimal(12, 2) @map("joining_fee")
  activationDate DateTime? @db.Date @map("activation_date")
  expiryDate    DateTime?  @db.Date @map("expiry_date")
  status        String?    @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  membershipType MembershipType? @relation(fields: [membershipTypeId], references: [id])

  @@map("memberships")
}

model ShieldCard {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @unique @map("customer_id")
  cardNumber    String?    @unique @db.VarChar(100) @map("card_number")
  qrCode        String?    @db.Text @map("qr_code")
  status        String?    @db.VarChar(50)
  issuedBusinessId BigInt? @map("issued_business_id")
  issuedAt      DateTime?  @db.Timestamptz(6) @map("issued_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  issuedBusiness Business? @relation(fields: [issuedBusinessId], references: [id])

  @@map("shield_cards")
}

// ------------------------------
// Wallet & Credit Tables
// ------------------------------
model Wallet {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @unique @map("customer_id")
  status        String?    @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  walletTransactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  walletId      BigInt?    @map("wallet_id")
  transactionType String?  @db.VarChar(50) @map("transaction_type")
  subLedgerType String?    @default("CASH") @db.VarChar(50) @map("sub_ledger_type")
  amount        Decimal?   @db.Decimal(15, 2)
  referenceType String?    @db.VarChar(100) @map("reference_type")
  referenceId   BigInt?    @map("reference_id")
  remarks       String?    @db.Text
  createdBy     BigInt?    @map("created_by")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  wallet        Wallet?    @relation(fields: [walletId], references: [id])
  createdByUser User?      @relation(fields: [createdBy], references: [id])

  @@index([walletId], map: "idx_wallet_transaction_wallet")
  @@index([transactionType], map: "idx_wallet_transaction_type")
  @@index([createdAt], map: "idx_wallet_transaction_date")
  @@map("wallet_transactions")
}

model CreditAccount {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @unique @map("customer_id")
  creditLimit   Decimal?   @db.Decimal(15, 2) @map("credit_limit")
  availableCredit Decimal?  @db.Decimal(15, 2) @map("available_credit")
  outstandingAmount Decimal? @db.Decimal(15, 2) @map("outstanding_amount")
  status        String?    @db.VarChar(50)

  customer      Customer?  @relation(fields: [customerId], references: [id])
  creditTransactions CreditTransaction[]

  @@map("credit_accounts")
}

model CreditTransaction {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  creditAccountId BigInt?  @map("credit_account_id")
  transactionType String?  @db.VarChar(50) @map("transaction_type")
  amount        Decimal?   @db.Decimal(15, 2)
  remarks       String?    @db.Text
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  creditAccount CreditAccount? @relation(fields: [creditAccountId], references: [id])

  @@map("credit_transactions")
}

// ------------------------------
// Service Provider & Products Tables
// ------------------------------
model ServiceProvider {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  businessId    BigInt?    @map("business_id")
  providerName  String?    @db.VarChar(255) @map("provider_name")
  providerType  String?    @db.VarChar(100) @map("provider_type")
  status        String?    @db.VarChar(50)

  business      Business?  @relation(fields: [businessId], references: [id])
  purchases     Purchase[]
  appointments  Appointment[]

  @@map("service_providers")
}

model ProductCategory {
  id            BigInt     @id @default(autoincrement())
  name          String?    @db.VarChar(255)

  products      Product[]

  @@map("product_categories")
}

model Product {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  productCode   String?    @db.VarChar(100) @map("product_code")
  productName   String?    @db.VarChar(255) @map("product_name")
  brand         String?    @db.VarChar(255)
  categoryId    BigInt?    @map("category_id")
  unit          String?    @db.VarChar(50)

  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  purchaseItems PurchaseItem[]

  @@map("products")
}

// ------------------------------
// Purchase Tables
// ------------------------------
model Purchase {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @map("customer_id")
  providerId    BigInt?    @map("provider_id")
  invoiceNumber String?    @db.VarChar(255) @map("invoice_number")
  totalAmount   Decimal?   @db.Decimal(15, 2) @map("total_amount")
  discountAmount Decimal?  @db.Decimal(15, 2) @map("discount_amount")
  payableAmount Decimal?   @db.Decimal(15, 2) @map("payable_amount")
  purchaseDate  DateTime?  @db.Timestamptz(6) @map("purchase_date")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  provider      ServiceProvider? @relation(fields: [providerId], references: [id])
  purchaseItems PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id            BigInt     @id @default(autoincrement())
  purchaseId    BigInt?    @map("purchase_id")
  productId     BigInt?    @map("product_id")
  quantity      Decimal?   @db.Decimal(12, 2)
  unitPrice     Decimal?   @db.Decimal(15, 2) @map("unit_price")
  totalPrice    Decimal?   @db.Decimal(15, 2) @map("total_price")

  purchase      Purchase?  @relation(fields: [purchaseId], references: [id])
  product       Product?   @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ------------------------------
// Appointment & Consultation Tables
// ------------------------------
model Appointment {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @map("customer_id")
  providerId    BigInt?    @map("provider_id")
  appointmentType String?  @db.VarChar(50) @map("appointment_type")
  appointmentDate DateTime? @db.Timestamptz(6) @map("appointment_date")
  status        String?    @db.VarChar(50)
  remarks       String?    @db.Text

  customer      Customer?  @relation(fields: [customerId], references: [id])
  provider      ServiceProvider? @relation(fields: [providerId], references: [id])
  consultations Consultation[]
  labReports    LabReport[]
  dentalRecords DentalRecord[]

  @@index([customerId], map: "idx_appointment_customer")
  @@index([providerId], map: "idx_appointment_provider")
  @@index([appointmentDate], map: "idx_appointment_date")
  @@index([status], map: "idx_appointment_status")
  @@map("appointments")
}

model Consultation {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  appointmentId BigInt?    @map("appointment_id")
  doctorName    String?    @db.VarChar(255) @map("doctor_name")
  diagnosis     String?    @db.Text
  notes         String?    @db.Text

  customer      Customer?  @relation(fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]

  @@map("consultations")
}

// ------------------------------
// Document Tables
// ------------------------------
model Document {
  id            BigInt     @id @default(autoincrement())
  uuid          String?    @unique @db.Uuid
  customerId    BigInt?    @map("customer_id")
  uploadedBy    BigInt?    @map("uploaded_by")
  documentType  String?    @db.VarChar(100) @map("document_type")
  fileName      String?    @db.VarChar(255) @map("file_name")
  storagePath   String?    @db.Text @map("storage_path")
  fileSize      BigInt?    @map("file_size")
  mimeType      String?    @db.VarChar(100) @map("mime_type")
  status        String?    @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  uploadedByUser User?     @relation(fields: [uploadedBy], references: [id])
  documentClassifications DocumentClassification[]
  documentExtractions DocumentExtraction[]
  documentProcessingLogs DocumentProcessingLog[]
  prescriptions Prescription[]
  labReports    LabReport[]

  @@map("documents")
}

model DocumentClassification {
  id            BigInt     @id @default(autoincrement())
  documentId    BigInt?    @map("document_id")
  classification String?   @db.VarChar(100)
  confidence    Decimal?   @db.Decimal(5, 2)

  document      Document?  @relation(fields: [documentId], references: [id])

  @@map("document_classifications")
}

model DocumentExtraction {
  id            BigInt     @id @default(autoincrement())
  documentId    BigInt?    @map("document_id")
  extractedText String?    @db.Text @map("extracted_text")
  confidenceScore Decimal?  @db.Decimal(5, 2) @map("confidence_score")
  extractionStatus String?  @db.VarChar(50) @map("extraction_status")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  document      Document?  @relation(fields: [documentId], references: [id])

  @@map("document_extractions")
}

model DocumentProcessingLog {
  id            BigInt     @id @default(autoincrement())
  documentId    BigInt?    @map("document_id")
  stage         String?    @db.VarChar(100)
  status        String?    @db.VarChar(50)
  remarks       String?    @db.Text
  processedAt   DateTime?  @db.Timestamptz(6) @map("processed_at")

  document      Document?  @relation(fields: [documentId], references: [id])

  @@map("document_processing_logs")
}

model Prescription {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  consultationId BigInt?   @map("consultation_id")
  documentId    BigInt?    @map("document_id")
  issueDate     DateTime?  @db.Date @map("issue_date")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  consultation  Consultation? @relation(fields: [consultationId], references: [id])
  document      Document?  @relation(fields: [documentId], references: [id])

  @@map("prescriptions")
}

model LabReport {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  appointmentId BigInt?    @map("appointment_id")
  documentId    BigInt?    @map("document_id")
  reportDate    DateTime?  @db.Date @map("report_date")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  document      Document?  @relation(fields: [documentId], references: [id])

  @@map("lab_reports")
}

model DentalRecord {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  appointmentId BigInt?    @map("appointment_id")
  treatmentName String?    @db.VarChar(255) @map("treatment_name")
  notes         String?    @db.Text

  customer      Customer?  @relation(fields: [customerId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("dental_records")
}

// ------------------------------
// CRM Tables
// ------------------------------
model CrmActivity {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  activityType  String?    @db.VarChar(50) @map("activity_type")
  notes         String?    @db.Text
  createdBy     BigInt?    @map("created_by")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])
  createdByUser User?      @relation(fields: [createdBy], references: [id])

  @@map("crm_activities")
}

model CrmTask {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  assignedTo    BigInt?    @map("assigned_to")
  dueDate       DateTime?  @db.Timestamptz(6) @map("due_date")
  status        String?    @db.VarChar(50)
  notes         String?    @db.Text

  customer      Customer?  @relation(fields: [customerId], references: [id])
  assignedToUser User?     @relation(fields: [assignedTo], references: [id])

  @@map("crm_tasks")
}

model Complaint {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  complaintType String?    @db.VarChar(100) @map("complaint_type")
  description   String?    @db.Text
  status        String?    @db.VarChar(50)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])

  @@map("complaints")
}

// ------------------------------
// Notification & Audit Tables
// ------------------------------
model Notification {
  id            BigInt     @id @default(autoincrement())
  customerId    BigInt?    @map("customer_id")
  title         String?    @db.VarChar(255)
  message       String?    @db.Text
  channel       String?    @db.VarChar(50)
  status        String?    @db.VarChar(50)
  sentAt        DateTime?  @db.Timestamptz(6) @map("sent_at")

  customer      Customer?  @relation(fields: [customerId], references: [id])

  @@map("notifications")
}

model DevicePushToken {
  id            BigInt     @id @default(autoincrement())
  uuid          String     @unique @db.Uuid
  customerId    BigInt     @map("customer_id")
  token         String     @unique @db.Text
  platform      String     @db.VarChar(30)
  deviceLabel   String?    @db.VarChar(120) @map("device_label")
  isActive      Boolean    @default(true) @map("is_active")
  lastSeenAt    DateTime   @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_device_push_tokens_customer")
  @@index([platform], map: "idx_device_push_tokens_platform")
  @@map("device_push_tokens")
}

model AuditLog {
  id            BigInt     @id @default(autoincrement())
  userId        BigInt?    @map("user_id")
  action        String?    @db.VarChar(255)
  entityType    String?    @db.VarChar(100) @map("entity_type")
  entityId      BigInt?    @map("entity_id")
  oldData       Json?      @map("old_data")
  newData       Json?      @map("new_data")
  ipAddress     String?    @db.VarChar(100) @map("ip_address")
  deviceInfo    String?    @db.Text @map("device_info")
  createdAt     DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")

  user          User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
