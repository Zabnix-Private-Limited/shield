model DevicePushToken {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @db.Uuid
  customerId   BigInt   @map("customer_id")
  authDeviceId BigInt?  @map("auth_device_id")
  token        String   @unique @db.Text
  platform     String   @db.VarChar(30)
  deviceLabel  String?  @map("device_label") @db.VarChar(120)
  isActive     Boolean  @default(true) @map("is_active")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authDevice AuthDevice? @relation(fields: [authDeviceId], references: [id], onDelete: SetNull)

  @@index([customerId], map: "idx_device_push_tokens_customer")
  @@index([authDeviceId], map: "idx_device_push_tokens_auth_device")
  @@index([platform], map: "idx_device_push_tokens_platform")
  @@map("device_push_tokens")
}

model AuthDevice {
  id              BigInt   @id @default(autoincrement())
  uuid            String   @unique @db.Uuid
  ownerType       String   @map("owner_type") @db.VarChar(30)
  ownerId         String   @map("owner_id") @db.VarChar(50)
  customerId      BigInt?  @map("customer_id")
  userId          BigInt?  @map("user_id")
  fingerprintHash String   @map("fingerprint_hash") @db.VarChar(128)
  deviceId        String?  @map("device_id") @db.VarChar(120)
  deviceName      String?  @map("device_name") @db.VarChar(255)
  platform        String?  @db.VarChar(50)
  browser         String?  @db.VarChar(100)
  os              String?  @db.VarChar(100)
  ipAddress       String?  @map("ip_address") @db.VarChar(100)
  userAgent       String?  @map("user_agent") @db.Text
  isTrusted       Boolean  @default(false) @map("is_trusted")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSessions AuthSession[]
  pushTokens   DevicePushToken[]
  loginHistory LoginHistory[]

  @@unique([ownerType, ownerId, fingerprintHash], map: "uq_auth_devices_owner_fingerprint")
  @@index([customerId], map: "idx_auth_devices_customer")
  @@index([userId], map: "idx_auth_devices_user")
  @@index([lastSeenAt], map: "idx_auth_devices_last_seen")
  @@map("auth_devices")
}

model AuthSession {
  id                    BigInt    @id @default(autoincrement())
  uuid                  String    @unique @db.Uuid
  sessionId             String    @unique @map("session_id") @db.Uuid
  subjectId             String    @map("subject_id") @db.VarChar(120)
  ownerType             String    @map("owner_type") @db.VarChar(30)
  ownerId               String    @map("owner_id") @db.VarChar(50)
  customerId            BigInt?   @map("customer_id")
  userId                BigInt?   @map("user_id")
  authDeviceId          BigInt?   @map("auth_device_id")
  principalType         String    @map("principal_type") @db.VarChar(30)
  roleCode              String?   @map("role_code") @db.VarChar(50)
  userType              String?   @map("user_type") @db.VarChar(30)
  accessScope           String?   @map("access_scope") @db.VarChar(30)
  permissions           Json?     @map("permissions")
  firebaseUid           String?   @map("firebase_uid") @db.VarChar(128)
  authProvider          String?   @map("auth_provider") @db.VarChar(30)
  email                 String?   @db.VarChar(255)
  mobile                String?   @db.VarChar(20)
  branchBusinessId      String?   @map("branch_business_id") @db.VarChar(50)
  loginMethod           String?   @map("login_method") @db.VarChar(50)
  refreshTokenHash      String    @unique @map("refresh_token_hash") @db.VarChar(128)
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddress             String?   @map("ip_address") @db.VarChar(100)
  userAgent             String?   @map("user_agent") @db.Text
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason         String?   @map("revoked_reason") @db.Text
  isCurrent             Boolean   @default(true) @map("is_current")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  authDevice AuthDevice? @relation(fields: [authDeviceId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId], map: "idx_auth_sessions_owner")
  @@index([customerId], map: "idx_auth_sessions_customer")
  @@index([userId], map: "idx_auth_sessions_user")
  @@index([authDeviceId], map: "idx_auth_sessions_auth_device")
  @@index([isCurrent], map: "idx_auth_sessions_current")
  @@index([refreshTokenExpiresAt], map: "idx_auth_sessions_refresh_expiry")
  @@map("auth_sessions")
}

