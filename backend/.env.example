NODE_ENV=development
APP_NAME=SHIELD
APP_URL=http://127.0.0.1:53431
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:53431,http://127.0.0.1:53431,http://localhost:3000,http://127.0.0.1:3000

PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Leave empty when SHIELD serves files through signed URLs instead of a public bucket.
R2_PUBLIC_BASE_URL=

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase env/your-firebase-adminsdk.json
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_WEB_VAPID_KEY=
FIREBASE_ANDROID_API_KEY=your-firebase-android-api-key
FIREBASE_ANDROID_APP_ID=your-firebase-android-app-id
FIREBASE_IOS_API_KEY=your-firebase-ios-api-key
FIREBASE_IOS_APP_ID=your-firebase-ios-app-id
FIREBASE_IOS_CLIENT_ID=your-firebase-ios-client-id
FIREBASE_IOS_BUNDLE_ID=com.example.app

ENABLE_SENTRY=false
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT_FLUTTER=your-sentry-flutter-project
SENTRY_PROJECT_WEB=your-sentry-web-project
SENTRY_PROJECT_BACKEND=your-sentry-backend-project
SENTRY_FLUTTER_DSN=
SENTRY_WEB_DSN=
SENTRY_BACKEND_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PRESCRIPTION_AI_URL=http://127.0.0.1:8010
OCR_ENABLED=false
OCR_TIMEOUT_MS=120000
